# Copy this file to .env and adjust the values.
#   cp .env.example .env

# Environment: development | production
ENVIRONMENT=development

# PostgreSQL from docker-compose (port 5433 on the host).
# If left empty, the API falls back to SQLite (memberplus.db).
DATABASE_URL=postgresql+psycopg://memberplus:memberplus@localhost:5433/memberplus

# Credentials docker-compose uses to create the database
POSTGRES_USER=memberplus
POSTGRES_PASSWORD=memberplus
POSTGRES_DB=memberplus

# JWT. Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login brute-force protection: failed attempts allowed per email before it is
# locked, and how long the lock lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Session cookie (true in production behind HTTPS)
COOKIE_SECURE=false

# Frontend origins allowed by CORS, comma-separated
CORS_ORIGINS=http://localhost:3000

# Password for the demo users created by `uv run python -m scripts.seed`.
# Empty in development = the known demo password. Required in production.
SEED_PASSWORD=

# Public URL of the frontend: the card link is {FRONTEND_PUBLIC_URL}/tarjeta/<token>.
FRONTEND_PUBLIC_URL=http://localhost:3000

# Email (card link). Mailpit from docker-compose: inbox at http://localhost:8025.
# Empty SMTP_HOST in development = the email is only logged. In production it is required.
# SMTP_TLS: none | starttls | ssl
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@memberplus.mx

# Google Wallet. Leave empty to disable it (the card page hides the button).
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON is the service account key (secret), as one line of JSON.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_ORIGINS=http://localhost:3000
GOOGLE_WALLET_LOGO_URL=

# Requests per minute and IP to the public card endpoints.
CARD_RATE_LIMIT_PER_MINUTE=30

# Image storage through the S3 API. Locally, the `storage` service of
# docker-compose (RustFS). Leave S3_ENDPOINT_URL empty to disable storage:
# the API still runs and logo uploads answer 503.
S3_ENDPOINT_URL=http://localhost:9000
# Host the browser uses for signed image URLs (empty = same as S3_ENDPOINT_URL).
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=memberplus
S3_SECRET_KEY=memberplus-dev-secret
S3_BUCKET=memberplus
S3_URL_EXPIRE_SECONDS=3600
